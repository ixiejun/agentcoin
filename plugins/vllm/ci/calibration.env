# Sample counts and seed of the TOPLOC calibration workflow (.github/workflows/toploc-calibration.yml,
# m6-toploc-verify design D7). Changing this file and pushing runs the workflow. The counts are
# totals, split evenly over the shards (the workflow's matrix has the same number of entries).
# Every variable set here is exported to the engines.
# Seed 1 (3,000 / 100) and seed 2 (600 / 50) showed inexact honest prefill chunks only on Intel
# CPUs with AMX. Seed 3 (600 / 50), with oneDNN kept from AMX kernels, had none on any CPU, so
# re-checks run with AMX off (the plugin enforces it in verify mode). Seed 4 confirms it at the
# full sample size. Seed 5 lets the generating engines use AMX (CALIBRATION_PROVER_ISA=ALL):
# provers with AMX re-checked without it, on whichever runners have AMX
# (m6-toploc-gpu-calibration 4.4). Seed 6 repeats it at d860981 (thresholds version 4, token IDs
# recorded) for the CPU cells of the cross-hardware calibration, 400 honest answers a shard so the
# slowest runners stay within the job limit (m6-toploc-gpu-calibration 8.4).
CALIBRATION_HONEST=4000
CALIBRATION_CHEAT=100
CALIBRATION_SEED=6
CALIBRATION_SHARDS=10
ONEDNN_MAX_CPU_ISA=AVX512_CORE_BF16
# Cross-hardware calibration (m6-toploc-gpu-calibration design D4). A bundle: the shards re-check
# the cases of the release asset CALIBRATION_BUNDLE_FILE of release CALIBRATION_BUNDLE_RELEASE
# (its SHA-256 checked) instead of generating; the counts and seed above are then unused.
# Release calibration-gpu-2 (d860981, thresholds version 4, token IDs recorded) was re-checked
# this way, one push per bundle (m6-toploc-gpu-calibration 8.3): bundle-rtx-5090-seed11.tar.gz
# (a97fc90c…) at dfd6253, bundle-h800-pcie-seed12.tar.gz (60072e0b…) at f07a2de.
CALIBRATION_BUNDLE_RELEASE=
CALIBRATION_BUNDLE_FILE=
CALIBRATION_BUNDLE_SHA256=
# The generating engines' ONEDNN_MAX_CPU_ISA (e.g. ALL: a provider with AMX kernels); empty: the
# same as the re-checking engines'.
CALIBRATION_PROVER_ISA=ALL
