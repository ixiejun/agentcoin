# Pins for the vllm-plugin CI job (m5-engine-toploc 7.1), read by scripts/setup-vllm-cpu.sh.
# A new vLLM release or model revision is a change of these lines (and of the plugin's
# supported range) that must pass the job.
VLLM_VERSION=0.30.0
# The x86-64 CPU wheel of the release (glibc 2.39: ubuntu-24.04 runners); digest as GitHub lists it.
VLLM_WHEEL_URL=https://github.com/vllm-project/vllm/releases/download/v0.30.0/vllm-0.30.0%2Bcpu-cp38-abi3-manylinux_2_39_x86_64.whl
VLLM_WHEEL_SHA256=0ee75278b3626c5d0b7c310c6d62afae93e900f4eac339c91e333fde5108ed78
TORCH_INDEX=https://download.pytorch.org/whl/cpu
MODEL=Qwen/Qwen2.5-0.5B-Instruct
MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
# The re-check calibration's "another model" (m6-toploc-verify design D7): same architecture and
# hidden size as MODEL, other weights. An empty revision makes the setup print the current one.
CHEAT_MODEL=Qwen/Qwen2.5-0.5B
CHEAT_MODEL_REVISION=060db6499f32faf8b98477b0a26969ef7d8b9987
# Snapshot digests of MODEL and CHEAT_MODEL at their revisions (scripts/verify-model.py: SHA-256
# of every file's `<sha256>  <path>` line, sorted), so that a mirror cannot serve other files
# (m6-toploc-gpu-calibration 3.1). Empty: the setup prints the digest it found and fails.
MODEL_SNAPSHOT_SHA256=
CHEAT_MODEL_SNAPSHOT_SHA256=
# The public jobs' embedding model (m6-public-jobs 6.1): a small BERT-style model vLLM serves
# with its pooling runner. An empty revision makes the setup print the current one.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# The CUDA build of the same vLLM release for GPU machines (scripts/gpu-calibration.sh,
# m6-toploc-gpu-calibration 3.1): the x86-64 wheel on PyPI and its digest as PyPI lists it. It
# depends on torch 2.13.0, built for CUDA 13.0: the GPU driver must support CUDA 13.0 (driver
# 580 or newer).
VLLM_CUDA_WHEEL_URL=https://files.pythonhosted.org/packages/1a/25/f5087a8f382e197a73672768b389d020b9d92e38371c3b0fc6dd883bbb34/vllm-0.30.0-cp38-abi3-manylinux_2_28_x86_64.whl
VLLM_CUDA_WHEEL_SHA256=ef52ee58c410ead0b8afb190838fa4cbcb52075596f67862a03859d984966ac4
TORCH_VERSION=2.13.0
CUDA_MIN_VERSION=13.0
